# ---------------------------------------------------------------------------
# Social Command Center — Dr. Pritesh Patel
#
# Every variable here is read on the SERVER ONLY (no VITE_ prefix), so no token
# reaches the browser bundle. Copy this file to .env, fill it in, and restart
# the dev server.
# ---------------------------------------------------------------------------

# Apify — powers every scrape.
# Get it at https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Supabase — stores each sync so the follower growth curve accumulates.
# SUPABASE_URL and the publishable key are already set below by Lovable; the
# service-role key is the one you need to add. Find it in the Supabase dashboard
# under Project Settings → API → service_role. It bypasses RLS, so it must never
# be committed or exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Already present in .env (Lovable-managed) — listed here for completeness:
#   SUPABASE_URL
#   SUPABASE_PROJECT_ID
#   SUPABASE_PUBLISHABLE_KEY
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_PROJECT_ID
#   VITE_SUPABASE_PUBLISHABLE_KEY

# Competitor watchlists — comma-separated. Each handle is scraped every sync
# and billed by Apify, so keep these lists deliberate.
# Accepts bare handles, @handles, or full profile URLs.
#   COMPETITORS_INSTAGRAM=somehandle,anotherhandle
#   COMPETITORS_LINKEDIN=some-public-id,another-public-id
COMPETITORS_INSTAGRAM=
COMPETITORS_LINKEDIN=

# OpenAI — powers the competitor read and the content ideas.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o; set whatever the account has access to.
OPENAI_MODEL=

# Competitors are now discovered automatically by the AI panel and stored in
# the competitor_watchlist table. These env lists are for pinning accounts by
# hand; anything here is always kept and never displaced by discovery.
